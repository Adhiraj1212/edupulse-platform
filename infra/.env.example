# Copy to infra/.env on the EC2 host and replace every CHANGE_ME.
# Use hex/alphanumeric passwords (they are embedded in connection URLs):
#   openssl rand -hex 24

# Private IP of this EC2 instance. Ports 3306/6379/5672 bind to it only.
# (127.0.0.1 = reachable from this host only, fine for local testing.)
BIND_IP=127.0.0.1

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=student_db
MYSQL_USER=student
MYSQL_PASSWORD=CHANGE_ME
AUDIT_DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

RABBITMQ_USER=edupulse
RABBITMQ_PASSWORD=CHANGE_ME
