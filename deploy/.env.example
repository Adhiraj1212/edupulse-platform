# EduPulse Environment Configuration Template
# Place this at /opt/edupulse/.env on the target EC2 host
# Strong alphanumeric passwords are recommended: openssl rand -hex 16

# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=student_db
MYSQL_USER=student
MYSQL_PASSWORD=change_this_student_db_password
AUDIT_DB_PASSWORD=change_this_audit_db_password

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password

# RabbitMQ Configuration
RABBITMQ_USER=edupulse
RABBITMQ_PASSWORD=change_this_rabbitmq_password

# EduPulse Application Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=administrator
STUDENT_USER=student
STUDENT_PASSWORD=student123

# Security & Port Settings
COOKIE_SECURE=false
WEB_PORT=80
